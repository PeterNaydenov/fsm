{
  "name": "@peter.naydenov/fsm",
  "description": "Finite State Machine",
  "version": "6.0.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/fsm.umd.js",
  "types": "./dist/types/main.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/fsm.esm.mjs"
      },
      "require": {
        "types": "./dist/types/main.d.cts",
        "default": "./dist/fsm.cjs"
      },
      "default": {
        "types": "./dist/types/main.d.cts",
        "default": "./dist/fsm.umd.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "Changelog.md",
    "Migration.guide.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build:types": "tsc -p tsconfig.json && node scripts/build-cts-types.js",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json",
    "build": "npm run build:types && rollup -c",
    "prepublishOnly": "npm test && npm run test:types && rollup -c"
  },
  "dependencies": {
    "@peter.naydenov/dt-queries": "^1.1.8",
    "ask-for-promise": "^3.2.0",
    "dt-toolbox": "^8.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "rollup": "^4.64.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/fsm.git"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
