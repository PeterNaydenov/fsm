{
  "name": "@peter.naydenov/fsm",
  "description": "Finite State Machine",
  "version": "5.3.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/fsm.umd.js",
  "types": "./dist/types/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/fsm.esm.mjs",
      "require": "./dist/fsm.cjs",
      "default": "./dist/fsm.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build:types": "tsc -p tsconfig.json",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json",
    "build": "npm run build:types && rollup -c"
  },
  "dependencies": {
    "@peter.naydenov/dt-queries": "^1.1.6",
    "ask-for-promise": "^3.2.0",
    "dt-toolbox": "^7.5.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "rollup": "^4.64.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/fsm.git"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
